{
  "type": "minecraft:tree",
  "below_trunk_provider": {
    "type": "minecraft:rule_based",
    "rules": [
      {
        "if_true": {
          "type": "minecraft:not",
          "predicate": {
            "type": "minecraft:matching_block_tag",
            "tag": "minecraft:cannot_replace_below_tree_trunk"
          }
        },
        "then": {
          "id": "turmo:mystic_sand"
        }
      }
    ]
  },
  "foliage_provider": {
    "id": "turmo:glow_algae"
  },
  "trunk_provider": {
    "id": "turmo:coral_column"
  },
  "root_placer": {
    "type": "minecraft:mangrove_root_placer",
    "root_provider": {
      "id": "turmo:shell_tile"
    },
    "trunk_offset_y": {
      "type": "uniform",
      "min_inclusive": 1,
      "max_inclusive": 3
    },
    "mangrove_root_placement": {
      "can_grow_through": "#mangrove_roots_can_grow_through",
      "muddy_roots_in": [
        "minecraft:water",
        "turmo:glow_algae"
      ],
      "muddy_roots_provider": {
        "id": "turmo:shell_tile"
      },
      "max_root_length": 15,
      "max_root_width": 8,
      "random_skew_chance": 0.2
    }
  },
  "ignore_vines": true,
  "foliage_placer": {
    "type": "minecraft:random_spread_foliage_placer",
    "radius": 3,
    "offset": 0,
    "foliage_height": 2,
    "leaf_placement_attempts": 70
  },
  "trunk_placer": {
    "type": "minecraft:upwards_branching_trunk_placer",
    "base_height": 2,
    "height_rand_a": 1,
    "height_rand_b": 4,
    "can_grow_through": "#minecraft:mangrove_logs_can_grow_through",
    "place_branch_per_log_probability": 0.5,
    "extra_branch_length": {
      "type": "minecraft:uniform",
      "min_inclusive": 0,
      "max_inclusive": 1
    },
    "extra_branch_steps": {
      "type": "minecraft:uniform",
      "min_inclusive": 1,
      "max_inclusive": 4
    }
  },
  "minimum_size": {
    "type": "minecraft:two_layers_feature_size",
    "limit": 2,
    "lower_size": 0,
    "upper_size": 2
  },
  "decorators": []
}